def print_pack_report(quantity_boxes):
    if quantity_boxes%3==0 and quantity_boxes%5==0:
        print(f'{quantity_boxes} - расфасуем по 3 или по 5')
    elif quantity_boxes%5==0:
        print(f'{quantity_boxes} - расфасуем по 5')
    elif quantity_boxes%3==0:
        print(f'{quantity_boxes} - расфасуем по 3')
    else:
        print(f'{quantity_boxes} - не заказываем!')
